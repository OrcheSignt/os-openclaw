{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789,
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    }
  },
  "mcp": {
    "servers": {
      "orchesight-ediscovery": {
        "url": "http://os-openclaw-mcp-app/mcp",
        "transport": "streamable-http",
        "headers": {
          "Authorization": "Bearer ${OPENCLAW_MCP_TOKEN_EDISCOVERY}"
        },
        "codex": {
          "agents": ["ediscovery"]
        }
      },
      "orchesight-privacy": {
        "url": "http://os-openclaw-mcp-app/mcp",
        "transport": "streamable-http",
        "headers": {
          "Authorization": "Bearer ${OPENCLAW_MCP_TOKEN_PRIVACY}"
        },
        "codex": {
          "agents": ["privacy"]
        }
      },
      "orchesight-cyber": {
        "url": "http://os-openclaw-mcp-app/mcp",
        "transport": "streamable-http",
        "headers": {
          "Authorization": "Bearer ${OPENCLAW_MCP_TOKEN_CYBER}"
        },
        "codex": {
          "agents": ["cyber"]
        }
      },
      "orchesight-compliance": {
        "url": "http://os-openclaw-mcp-app/mcp",
        "transport": "streamable-http",
        "headers": {
          "Authorization": "Bearer ${OPENCLAW_MCP_TOKEN_COMPLIANCE}"
        },
        "codex": {
          "agents": ["compliance"]
        }
      },
      "orchesight-recommendations": {
        "url": "http://os-openclaw-mcp-app/mcp",
        "transport": "streamable-http",
        "headers": {
          "Authorization": "Bearer ${OPENCLAW_MCP_TOKEN_RECOMMENDATIONS}"
        },
        "codex": {
          "agents": ["recommendations"]
        }
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "vllm/gpt_oss"
      }
    },
    "list": [
      {
        "id": "ediscovery",
        "workspace": "workspaces/ediscovery",
        "model": {
          "primary": "vllm/gpt_oss"
        },
        "tools": {
          "profile": "full",
          "allow": [
            "search_evidence", "get_item_details", "tag_items", "bulk_tag",
            "aggregate_data", "analyze_text", "create_notification",
            "create_task", "log_audit", "update_case_progress", "generate_report",
            "submit_plan", "get_plan", "record_step_result", "compose_answer",
            "abort_plan"
          ]
        }
      },
      {
        "id": "privacy",
        "workspace": "workspaces/privacy",
        "tools": {
          "profile": "full",
          "allow": [
            "search_evidence", "get_item_details", "tag_items", "bulk_tag",
            "analyze_text", "create_notification", "create_task",
            "log_audit", "generate_report"
          ]
        }
      },
      {
        "id": "cyber",
        "workspace": "workspaces/cyber",
        "tools": {
          "profile": "full",
          "allow": [
            "search_evidence", "get_item_details", "aggregate_data",
            "analyze_text", "create_notification", "create_task",
            "log_audit", "update_case_progress", "generate_report"
          ]
        }
      },
      {
        "id": "compliance",
        "workspace": "workspaces/compliance",
        "tools": {
          "profile": "full",
          "allow": [
            "search_evidence", "aggregate_data", "get_item_details",
            "create_notification", "create_task", "log_audit",
            "update_case_progress", "generate_report"
          ]
        }
      },
      {
        "id": "recommendations",
        "workspace": "workspaces/recommendations",
        "tools": {
          "profile": "full",
          "allow": [
            "search_evidence", "get_item_details", "aggregate_data",
            "analyze_text", "build_timeline", "cross_reference",
            "search_communications", "search_by_entity",
            "get_legal_references", "save_case_recommendation",
            "create_notification", "log_audit"
          ]
        }
      }
    ]
  },
  "models": {
    "providers": {
      "vllm": {
        "baseUrl": "http://vllm-server.prod.svc.cluster.local:8000/v1",
        "apiKey": "none",
        "api": "openai-completions",
        "models": [
          {
            "id": "gpt_oss",
            "name": "Qwen3.5-9B",
            "contextWindow": 131072,
            "maxTokens": 16384
          }
        ]
      }
    }
  },
  "cron": {
    "enabled": true,
    "maxConcurrentRuns": 2,
    "sessionRetention": "24h"
  }
}
