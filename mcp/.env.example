# os-openclaw-mcp environment variables

# API Gateway connection
OS_API_GATEWAY_URL=http://os-api-gateway-app/api/v1

# Shared secret used to sign service-to-service JWTs sent to the upstream
# API gateway. Must be at least 32 characters; the server refuses to start
# below this threshold.
JWT_SECRET=<from-k8s-secret>

# Agent identity (used in X-User-Id header for all gateway calls)
AGENT_USER_ID=<system-agent-mongodb-objectid>
AGENT_USER_EMAIL=openclaw-agent@orchesight.internal

# -----------------------------------------------------------------------------
# MCP transport authentication (REQUIRED)
# -----------------------------------------------------------------------------
# Bearer tokens, one per agent. The MCP server rejects any /mcp request
# whose Authorization header does not present one of these tokens, and
# enforces the per-agent `tools.allow` array from openclaw.json.
#
# Provide either OPENCLAW_MCP_TOKENS_JSON (preferred) OR per-agent
# OPENCLAW_MCP_TOKEN_<AGENT_ID> vars. Per-agent vars override the JSON.
#
# OPENCLAW_MCP_TOKENS_JSON='{"ediscovery":"<token1>","privacy":"<token2>","cyber":"<token3>","compliance":"<token4>","recommendations":"<token5>"}'
# OPENCLAW_MCP_TOKEN_EDISCOVERY=<token1>
# OPENCLAW_MCP_TOKEN_PRIVACY=<token2>

# Per-agent organizationId. The MCP server pins this onto every tool call
# the agent makes -- the model can no longer pass an arbitrary org id.
# Same precedence rules as the tokens above.
#
# OPENCLAW_AGENT_ORG_JSON='{"ediscovery":"<orgId>","privacy":"<orgId>",...}'
# OPENCLAW_AGENT_ORG_EDISCOVERY=<orgId>

# Optional override for openclaw.json location (default: ../openclaw.json
# relative to the running process).
# OPENCLAW_CONFIG_PATH=/etc/openclaw/openclaw.json

# Direct Triton access for high-volume ML batch operations
TRITON_GATEWAY_DIRECT_URL=http://triton-gateway.prod.svc.cluster.local:8080

# Server
PORT=3020
